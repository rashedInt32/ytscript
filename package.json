{
  "name": "ytscript",
  "version": "0.2.0",
  "description": "Fetch YouTube transcripts from the terminal. No login, no API key, no subscription.",
  "type": "module",
  "bin": {
    "ytscript": "dist/bin.js",
    "yts": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "youtube",
    "transcript",
    "subtitles",
    "captions",
    "cli",
    "llm",
    "ai",
    "effect"
  ],
  "license": "MIT",
  "author": "rashed <parvez08eee@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rashedInt32/ytscript.git"
  },
  "homepage": "https://github.com/rashedInt32/ytscript#readme",
  "bugs": {
    "url": "https://github.com/rashedInt32/ytscript/issues"
  },
  "dependencies": {
    "effect": "4.0.0-rc.113"
  },
  "optionalDependencies": {
    "@effect/platform-bun": "4.0.0-rc.113",
    "@opentui/core": "^0.5.11"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@types/bun": "latest",
    "@types/node": "^22",
    "typescript": "^5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "dev": "bun run src/bin.ts",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release": "changeset publish",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-rc.113"
  },
  "patchedDependencies": {
    "@effect/platform-node-shared@4.0.0-rc.113": "patches/@effect%2Fplatform-node-shared@4.0.0-rc.113.patch"
  }
}
